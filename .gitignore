# Alberti — .gitignore

# Reproduções verificadas fazem parte do museu publicado.
# Arquivos temporários do sincronizador continuam fora do repositório.

# Arquivos temporários de download
assets/**/*.tmp

# Node
node_modules/

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
# Temporários e relatórios locais do sincronizador de mídia
*.candidate
*.candidate.part
data/media-report.json
